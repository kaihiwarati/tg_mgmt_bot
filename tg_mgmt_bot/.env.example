# ═══════════════════════════════════════════════════════════
# Telegram Management Bot — Environment Template
# ═══════════════════════════════════════════════════════════
# Copy this file to .env and fill in real values.
# NEVER commit .env to GitHub — it's in .gitignore.

# ── Telegram API (from https://my.telegram.org) ──
API_ID=123456
API_HASH=your_api_hash_here

# ── Bot token (from @BotFather) ──
BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11

# ── Bot identity ──
BOT_NAME=Guardian

# ── Superadmins (comma-separated user IDs) ──
# Get your ID from @userinfobot
SUPERADMINS=123456789

# ── Optional log channel (leave empty to disable) ──
# Create a private channel, add bot as admin, put ID here.
LOG_CHANNEL=

# ── Startup notification (optional) ──
# "me" = Saved Messages (user mode only)
# your_user_id = DM to that user (bot must have been /start'ed)
# empty = no notification
STARTUP_NOTIFY=

# ── Debug logging ──
# false = clean terminal
# true = verbose per-message logs
DEBUG=false
